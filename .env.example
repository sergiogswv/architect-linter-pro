# Architect Linter Pro - Agent Configuration
# Copy this file to .env and adjust as needed

# URL del Cerebro (Orquestador central)
CEREBRO_URL=http://127.0.0.1:4000

# Puerto en el que escuchará el agente Architect
ARCHITECT_PORT=4002

# Habilitar reporte de eventos al Cerebro
CEREBRO_REPORT_ENABLED=true
