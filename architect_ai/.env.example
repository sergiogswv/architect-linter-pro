# Architect ADK Agent Configuration
# Port: 4012 (Sidecar), 4002 (Core Rust)

# LLM Provider: gemini | claude | openai | ollama
LLM_PROVIDER=ollama

# Gemini Settings (provider=gemini)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Claude Settings (provider=claude)
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-3-5-sonnet-latest

# OpenAI Settings (provider=openai)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# Ollama Settings (provider=ollama) - LOCAL LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Architecture Consultant Settings
ARCHITECT_CORE_URL=http://localhost:4002
CEREBRO_URL=http://localhost:8000
ARCHITECT_ADK_PORT=4012

# Database for Design Memory
ARCHITECT_DB_PATH=./architect_memory.db
